# Infinite Flight OAuth Credentials (Confidential client)
# Create an OAuth app at https://infiniteflight.com/account/api-keys
# and register this redirect URI exactly:
#   <NEXTAUTH_URL>/api/auth/callback
# (The app MUST use authorization_code + PKCE. The token exchange happens
#  server-side, so the client secret is never sent to the browser.)
IF_OAUTH_CLIENT_ID=your_client_id_here
IF_OAUTH_CLIENT_SECRET=your_client_secret_here

# Public HTTPS URL of the deployed website (e.g. your Railway domain).
# Used as the base for the OAuth redirect_uri and for routing.
# Must be https:// in production; do NOT use http://localhost:8080/callback here.
NEXTAUTH_URL=https://your-railway-app.up.railway.app

# Long random secret used to sign the server-side session JWT (HS256).
NEXTAUTH_SECRET=your_nextauth_secret_here

# Infinite Flight Live API token (v2) used ONLY for server-side fleet data.
IF_BEARER=your_if_access_token_here
