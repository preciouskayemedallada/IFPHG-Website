# Infinite Flight OAuth Credentials
# Get these from https://infiniteflight.com/account/api-keys
IF_OAUTH_CLIENT_ID=your_client_id_here
IF_OAUTH_CLIENT_SECRET=your_client_secret_here

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# Infinite Flight Live API Token (v2 - for fleet data)
IF_BEARER=your_if_access_token_here
